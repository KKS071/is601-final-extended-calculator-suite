# File: .env.example
# Purpose: Template for environment variables. Copy to .env and fill in values.

# PostgreSQL connection
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fastapi_db
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fastapi_test_db

# JWT secrets — change these in production!
JWT_SECRET_KEY=your-super-secret-key-change-this-in-production
JWT_REFRESH_SECRET_KEY=your-refresh-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Security
BCRYPT_ROUNDS=12
